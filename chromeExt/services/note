sudo du -ch -d 1 | sort -hr
sudo find / -xdev -type f -size +100M -exec ls -lah {} \; | sort -nk 5
sudo du -xh / |grep '^\S*[0-9\.]\+G'|sort -rn
sudo docker rm  
sudo docker system prune -a

