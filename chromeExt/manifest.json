{
  "name": "Curbit",
  "description": "An item watcher Extension!",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeContent",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "geolocation"
  ],
  "content_scripts": [
    {
      "js": [
        "services/content.js"
      ],
      "matches": [
        "<all_urls>",
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "options_page": "/ui/options.html",
  "action": {
    "default_popup": "/ui/popup.html",
    "default_icon": {
      "16": "/content/images/get_started16.png",
      "32": "/content/images/get_started32.png",
      "48": "/content/images/get_started48.png",
      "128": "/content/images/get_started128.png"
    }
  },
  "icons": {
    "16": "/content/images/get_started16.png",
    "32": "/content/images/get_started32.png",
    "48": "/content/images/get_started48.png",
    "128": "/content/images/get_started128.png"
  }
}